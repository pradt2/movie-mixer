# Python bytecode and packaging artefacts
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/

# Virtual environments (the project's own .venv and any local one)
.venv/
venv/
env/

# Test, coverage and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Editor and OS noise
.idea/
.vscode/
*.swp
.DS_Store

# Local scratch: media fixtures, renders and exports must never be committed —
# test fixtures are generated by the scripts that describe them, and user films
# do not belong in this repository.
out/
scratch/
*.mkv
*.mov
*.mp4
*.wav
*.m4a
*.ac3
